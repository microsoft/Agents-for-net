<Project>
	<PropertyGroup>
		<A2ADotNetRepoCandidate>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\a2aproject\a2a-dotnet'))</A2ADotNetRepoCandidate>
		<A2ADotNetRepoRoot Condition="'$(A2ADotNetRepoRoot)' == '' and Exists('$(A2ADotNetRepoCandidate)\src\A2A\A2A.csproj')">$(A2ADotNetRepoCandidate)</A2ADotNetRepoRoot>
		<!-- Enabled Documentation for Libs folder-->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS1572;CS1574</NoWarn>
		<AnalysisLevel>latest-minimum</AnalysisLevel>
		<AnalysisMode>recommended</AnalysisMode>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
</Project>