<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ComponentAreaName>AgentRunner</ComponentAreaName>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agent-runner</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Hosts an Agents SDK registration-contract assembly on an authenticated loopback endpoint.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <Import Project="..\..\..\Build.Common.core.props" />
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AspNetCore\Microsoft.Agents.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Authentication\Authentication.Msal\Microsoft.Agents.Authentication.Msal.csproj" />
    <PackageReference Include="System.CommandLine" />
    <InternalsVisibleTo Include="Microsoft.Agents.Hosting.AgentRunner.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
