{
  // Configuration for receiving Slack traffic directly (no Azure Bot Service).
  // Values come from your Slack app at https://api.slack.com/apps.
  "Slack": {
    "BotToken": "xoxb-your-bot-token", // OAuth & Permissions -> Bot User OAuth Token
    "SigningSecret": "your-signing-secret", // Basic Information -> App Credentials -> Signing Secret
    "BotUserId": "U0000000000" // The bot user id (used as the Activity recipient and to ignore the bot's own messages)
  },

  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
