{
  "WorkIQ": {
    "TimeZone": "UTC"
  },
  "TokenValidation": {
    "Audiences": [ "{{ClientId}}" ],
    "TenantId": "{{TenantId}}",
    "ValidIssuers": [
      "https://login.microsoftonline.com/{{TenantId}}/v2.0",
      "https://sts.windows.net/{{TenantId}}/"
    ]
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "A2A": {
      "AgentCard": {
        "SecuritySchemes": {
          "delegated": {
            "OAuth2SecurityScheme": {
              "Flows": {
                "DeviceCode": {
                  "DeviceAuthorizationUrl": "https://login.microsoftonline.com/{{TenantId}}/oauth2/v2.0/devicecode",
                  "TokenUrl": "https://login.microsoftonline.com/{{TenantId}}/oauth2/v2.0/token",
                  "Scopes": {
                    "api://botid-{{ClientId}}/access_as_user": "Research a briefing and approve email as the signed-in user."
                  }
                }
              }
            }
          }
        }
      }
    },
    "UserAuthorization": {
      "DefaultHandlerName": "workiq",
      "AutoSignin": false,
      "Handlers": {
        "workiq": {
          "Assembly": "Microsoft.Agents.Extensions.A2A",
          "Type": "A2AUserAuthorization",
          "Settings": {
            "Mode": "RequestToken",
            "SecuritySchemeName": "delegated",
            "RequiredScopes": [ "api://botid-{{ClientId}}/access_as_user" ],
            "EnforceRequiredScopes": true,
            "OBOConnectionName": "ServiceConnection",
            "OBOScopes": [ "api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask" ]
          }
        },
        "mail": {
          "Assembly": "Microsoft.Agents.Extensions.A2A",
          "Type": "A2AUserAuthorization",
          "Settings": {
            "Mode": "RequestToken",
            "SecuritySchemeName": "delegated",
            "RequiredScopes": [ "api://botid-{{ClientId}}/access_as_user" ],
            "EnforceRequiredScopes": true,
            "OBOConnectionName": "ServiceConnection",
            "OBOScopes": [ "https://graph.microsoft.com/Mail.Send" ]
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{TenantId}}",
        "ClientId": "{{ClientId}}",
        "ClientSecret": "",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },
  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Agents": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
