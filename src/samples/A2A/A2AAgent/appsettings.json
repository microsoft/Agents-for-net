{
  "OutboundHostValidator": {
    "Enabled": false,
    "IncludeDefaultMicrosoftHosts": true,
    "Hosts": []
  },

  "TokenValidation": {
    "Audiences": [
      "{{ClientId}}" // this is the Client ID used for the Azure Bot
    ],
    "TenantId": "{{TenantId}}"
  },

  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,

    "A2A": {
      "AgentCard": {
        "SecuritySchemes": {
          "delegated": {
            "OAuth2SecurityScheme": {
              "Flows": {
                "DeviceCode": {
                  "DeviceAuthorizationUrl": "https://login.microsoftonline.com/organizations/oauth2/v2.0/devicecode",
                  "TokenUrl": "https://login.microsoftonline.com/organizations/oauth2/v2.0/token",
                  "Scopes": {
                    "api://{{ClientId}}/access_as_user": "Access the A2A Agent API as the signed-in user."
                  }
                }
              }
            }
          },
          "application": {
            "OAuth2SecurityScheme": {
              "Flows": {
                "ClientCredentials": {
                  "TokenUrl": "https://login.microsoftonline.com/{{TenantId}}/oauth2/v2.0/token",
                  "Scopes": {
                    "api://{{ClientId}}/.default": "Access the A2A Agent API with the assigned application permissions."
                  }
                }
              }
            }
          }
        }
      }
    },

    "UserAuthorization": {
      "DefaultHandlerName": "delegated",
      "AutoSignin": false,
      "Handlers": {
        "delegated": {
          "Type": "A2AUserAuthorization",
          "Settings": {
            "SecurityScheme": "delegated",
            "RequiredScopes": [
              "api://{{ClientId}}/access_as_user"
            ],
            "AuthorizationPolicy": "Delegated"
          }
        },
        "graph": {
          "Type": "A2AUserAuthorization",
          "Settings": {
            "SecurityScheme": "delegated",
            "RequiredScopes": [
              "api://{{ClientId}}/access_as_user"
            ],
            "AuthorizationPolicy": "Delegated",
            "OBOConnectionName": "ServiceConnection",
            "OBOScopes": [
              "User.Read"
            ]
          }
        },
        "app": {
          "Type": "A2AUserAuthorization",
          "Settings": {
            "SecurityScheme": "application",
            "RequiredScopes": [
              "api://{{ClientId}}/.default"
            ],
            "AuthorizationPolicy": "Application"
          }
        }
      }
    }
  },

  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret", // this is the AuthType for the connection, valid values can be found in Microsoft.Agents.Authentication.Msal.Model.AuthTypes.  The default is ClientSecret.
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{TenantId}}",
        "ClientId": "{{ClientId}}", // this is the Client ID used for the Azure Bot
        "ClientSecret": "00000000-0000-0000-0000-000000000000", // this is the Client Secret used for the connection.
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],

  "Logging": {
    "Debug": {
      "IncludeScopes": true
    },
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Microsoft.Agents": "Debug",
      "Microsoft.Agents.Authentication.Msal.MsalAuth": "Warning",
      "System.Net.Http.HttpClient.MSALClientFactory": "Warning",
      "System.Net.Http.HttpClient.Microsoft.Agents.Builder.RestChannelServiceClientFactory": "Warning",
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning"
    }
  }
}
