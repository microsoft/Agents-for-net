<Project>

  <PropertyGroup Condition="'$(A2ASampleTestPartition)' == 'Client'">
    <BaseIntermediateOutputPath>obj\client\</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\..\A2A.Local.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ComponentAreaName>CplTests.Samples.A2A</ComponentAreaName>
    <ComponentAreaName Condition="'$(A2ASampleTestPartition)' == 'Client'">CplTests.Samples.A2A.Client</ComponentAreaName>
    <SignAssembly>true</SignAssembly>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestProject Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net10.0'">false</IsTestProject>
  </PropertyGroup>

  <Import Project="..\\..\\Build.Common.core.props" />

  <ItemGroup>
    <Compile Remove="Properties\\**" />
    <EmbeddedResource Remove="Properties\\**" />
    <None Remove="Properties\\**" />
    <Compile Remove="A2AClient\**" Condition="'$(A2ADotNetRepoRoot)' != '' and '$(A2ASampleTestPartition)' != 'Client'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libraries\Extensions\Microsoft.Agents.Extensions.A2A\Microsoft.Agents.Extensions.A2A.csproj" Condition="'$(A2ASampleTestPartition)' != 'Client'" />
    <ProjectReference Include="..\..\samples\A2A\A2AAgent\A2AAgent.csproj" Aliases="A2AAgentSample" Condition="'$(A2ASampleTestPartition)' != 'Client'" />
    <ProjectReference Include="..\..\samples\A2A\A2AClient\A2AClient.csproj" Condition="'$(A2ADotNetRepoRoot)' == '' or '$(A2ASampleTestPartition)' == 'Client'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(A2ASampleTestPartition)' == 'Client'">
    <Compile Include="A2AClient\**\*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(A2ASampleTestPartition)' != 'Client'">
    <None Include="..\..\samples\A2A\A2AAgent\appsettings.json" Link="A2AAgent.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Restore separately so the nested build evaluates the partition's generated NuGet imports. -->
  <Target Name="RestorePackagedA2AClientTests"
          Condition="'$(TargetFramework)' == 'net10.0' and '$(A2ADotNetRepoRoot)' != '' and '$(A2ASampleTestPartition)' != 'Client'">
    <Exec Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot; -p:A2ASampleTestPartition=Client"
          Condition="'$(VSTestNoBuild)' != 'true'" />
  </Target>

  <Target Name="BuildPackagedA2AClientTests" AfterTargets="Build" DependsOnTargets="RestorePackagedA2AClientTests"
          Condition="'$(TargetFramework)' == 'net10.0' and '$(A2ADotNetRepoRoot)' != '' and '$(A2ASampleTestPartition)' != 'Client'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="A2ASampleTestPartition=Client" />
  </Target>

  <!-- One project, two isolated test processes: the local server and packaged client APIs are incompatible. -->
  <Target Name="RunPackagedA2AClientTests" BeforeTargets="VSTest" DependsOnTargets="RestorePackagedA2AClientTests"
          Condition="'$(TargetFramework)' == 'net10.0' and '$(A2ADotNetRepoRoot)' != '' and '$(A2ASampleTestPartition)' != 'Client'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="VSTest"
             Properties="A2ASampleTestPartition=Client" />
  </Target>

</Project>
