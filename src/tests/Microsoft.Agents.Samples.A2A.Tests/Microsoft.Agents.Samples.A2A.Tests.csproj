<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ComponentAreaName>CplTests.Samples.A2A</ComponentAreaName>
    <SignAssembly>true</SignAssembly>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestProject Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net10.0'">false</IsTestProject>
  </PropertyGroup>

  <Import Project="..\\..\\Build.Common.core.props" />

  <ItemGroup>
    <Compile Remove="Properties\\**" />
    <EmbeddedResource Remove="Properties\\**" />
    <None Remove="Properties\\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="A2A.Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Moq" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libraries\Extensions\Microsoft.Agents.Extensions.A2A\Microsoft.Agents.Extensions.A2A.csproj" />
    <ProjectReference Include="..\..\samples\A2A\A2AAgent\A2AAgent.csproj" Aliases="A2AAgentSample" />
    <ProjectReference Include="..\..\samples\A2A\A2ACli\A2ACli.csproj" />
    <ProjectReference Include="..\..\samples\A2A\WorkIQBriefingAgent\WorkIQBriefingAgent.csproj" Aliases="WorkIQBriefingSample" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Child-process CLI tests run beside this assembly. Web sample references also copy
         appsettings.json here, so explicitly stage the CLI configuration last. -->
    <None Include="..\..\samples\A2A\A2ACli\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="Always" />
    <None Include="..\..\samples\A2A\A2AAgent\appsettings.json" Link="A2AAgent.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\A2A\WorkIQBriefingAgent\appsettings.json" Link="WorkIQBriefingAgent.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
